{
  "schema_version": "1",
  "name": "Universal Agent Platform",
  "version": "2.3.1",
  "type": "agent-orchestration-framework",
  "product_positioning": "compact-project-context-platform",
  "summary": "UAP gives a fresh AI session a small verified project map and relevant paths so it can avoid repeated repository discovery.",
  "cli": "agentctl",

  "documentation": {
    "ai_bootstrap": "AI-BOOTSTRAP.md",
    "readme": "README.md",
    "manifest": "agent-platform.json",
    "orchestration_ownership": "docs/orchestration-ownership.md",
    "project_intelligence": "docs/project-intelligence.md",
    "amortized_context": "docs/amortized-context.md",
    "cold_warm_start": "docs/cold-warm-start.md",
    "simplified_core": "docs/v2.3.1-simplified-core.md",
    "read_first_if_you_are_an_ai": "AI-BOOTSTRAP.md"
  },

  "install": {
    "recommended": "pip install git+https://github.com/anan1999/universal-agent-platform.git",
    "from_pypi": null,
    "development": "git clone https://github.com/anan1999/universal-agent-platform.git && cd universal-agent-platform && pip install -e \".[dev]\"",
    "requires_python": ">=3.11",
    "verify": "agentctl --version"
  },

  "bootstrap": {
    "setup": "agentctl setup --auto",
    "project_init": "agentctl init --auto",
    "project_attach": "agentctl attach",
    "health": "agentctl doctor",
    "detach": "agentctl attach --detach"
  },

  "detection": {
    "installed": "agentctl --version",
    "platform_home_env": "UNIVERSAL_AGENT_HOME",
    "platform_home_default": "~/.universal-agent-platform",
    "platform_config": "platform.yaml",
    "project_initialized": ".agent/project.yaml",
    "project_marker_file": "AGENTS.md",
    "project_marker_start": "<!-- UAP:START -->",
    "project_marker_end": "<!-- UAP:END -->"
  },

  "discovery": {
    "providers": "agentctl providers --json",
    "profiles": "agentctl profiles --json",
    "models": "agentctl models --json",
    "agents": "agentctl agents --json",
    "skills": "agentctl skills --json",
    "tools": "agentctl tools --json",
    "project_status": "agentctl status --json",
    "project_context": "agentctl context --json"
  },

  "project_context": {
    "index": ".agent/project-index.json",
    "file_cache": ".agent/cache/files.json",
    "policy": "reuse_before_reexplore",
    "target_bytes": 4096,
    "maximum_bytes": 8192,
    "pre_task_ai_calls": 0,
    "recursive_scan": false
  },

  "project_intelligence": {
    "index": ".agent/intelligence.json",
    "default_hot_path": false,
    "classification": "experimental_analytics_and_legacy_compatibility",
    "policy": "reuse_before_relearn",
    "states": ["cold", "warm", "revalidation"],
    "item_statuses": ["current", "needs_revalidation", "superseded", "inactive", "needs_review"],
    "inspect": "agentctl intelligence explain --json",
    "explain": "agentctl context explain \"<goal>\" --json",
    "privacy": "Stores evidence-backed project facts and compact receipts; never conversations or hidden reasoning."
  },

  "orchestration": {
    "entrypoint": "agentctl orchestrate \"<goal>\" --json",
    "plan_only": "agentctl run \"<goal>\" --dry-run --json",
    "execute": "agentctl run \"<goal>\" --json",
    "explain": "agentctl explain <run-id> --json",
    "replay": "agentctl replay <run-id>",
    "recursion_guard_env": "UAP_CHILD_EXECUTION",
    "recursion_guard_note": "A process started with UAP_CHILD_EXECUTION=1 is a bounded executor and must never invoke the orchestrator again.",
    "execution_strategies": ["tool_only", "single_agent", "single_agent_with_tools", "multi_agent_parallel", "multi_agent_dag", "human_approval", "artifact_only"],
    "minimum_sufficient_rule": "Read compact project context, route one executor to relevant paths, load a procedure Skill only when clearly useful, then validate deterministically.",
    "default_ai_agents": 1,
    "pre_task_ai_calls": 0
  },

  "skill_intelligence": {
    "manifest_schema": "src/adaptive_agent/skills/manifest.py::SkillManifest",
    "discovery_order": ["built_in", "global_trusted", "project_local"],
    "progressive_loading": "Metadata is indexed first; instructions and explicitly selected references are loaded only for the executing task.",
    "trust_states": ["built_in", "trusted", "project_local", "unverified", "review_required", "blocked"],
    "lifecycle_states": ["active", "temporary", "experimental", "deprecated", "retired"],
    "commands": {
      "explain": "agentctl skill explain <skill-id>",
      "validate": "agentctl skill validate <skill-id>",
      "history": "agentctl skill history <skill-id>",
      "candidates": "agentctl skill candidates \"<capability>\""
    },
    "temporary_skill_safety": "Automatic Skill synthesis is OFF by default. When explicitly enabled, generated packages remain temporary, review-required, statically validated, and never overwrite an existing version."
  },

  "consumption_policies": {
    "default": "balanced",
    "available": ["economy", "balanced", "maximum"],
    "show_or_set_global": "agentctl consumption [economy|balanced|maximum]",
    "per_run": "agentctl run \"<goal>\" --consumption economy",
    "project_config": ".agent/project.yaml::consumption.mode",
    "note": "Economy reduces orchestration overhead but never bypasses mandatory provider capabilities, deterministic checks, or human approval gates."
  },

  "provider_architecture": {
    "contract": "src/adaptive_agent/providers/base.py::AIProvider",
    "registry": "src/adaptive_agent/providers/registry.py::ProviderRegistry",
    "states": ["available", "installed", "unconfigured", "configured", "connected", "unavailable", "unsupported"],
    "execution_modes": ["agentic_local", "api_reasoning", "local_model", "mock"],
    "capability_values": ["supported", "unsupported", "model_dependent", "unknown"],
    "implemented": ["codex", "cursor", "mock", "openai_compatible"],
    "plugin_ready": ["openai", "anthropic", "gemini", "ollama"],
    "selection": "auto",
    "prefer_command": "agentctl provider prefer <provider-id>",
    "test_command": "agentctl provider-test <provider-id>",
    "openai_compatible_environment": {
      "base_url": "UAP_OPENAI_COMPATIBLE_BASE_URL",
      "model": "UAP_OPENAI_COMPATIBLE_MODEL",
      "api_key": "UAP_OPENAI_COMPATIBLE_API_KEY or the variable named by UAP_OPENAI_COMPATIBLE_API_KEY_ENV"
    },
    "note": "OpenAI-compatible is API reasoning only and becomes ready after a successful bounded probe. Placeholder providers refuse execution."
  },

  "model_registry": {
    "catalog": "config/models.yaml",
    "user_overrides": "$UNIVERSAL_AGENT_HOME/models.yaml",
    "capability_levels": ["none", "low", "medium", "high", "very_high", "unknown"],
    "note": "Routing selects (provider, model) from required capabilities. Model names never appear in core routing code."
  },

  "work_profiles": {
    "builtin_directory": "config/profiles",
    "user_directory": "$UNIVERSAL_AGENT_HOME/profiles",
    "starter_packs": [
      "general",
      "software-engineering",
      "ai-engineering",
      "uiux",
      "design",
      "product",
      "research",
      "devops",
      "data-analysis",
      "technical-writing"
    ],
    "closed_taxonomy": false,
    "unknown_domain_behavior": "Fall back to the general profile and compose a team from inferred capabilities. An unrecognized domain is never an error.",
    "multi_profile": true
  },

  "project_initialization": {
    "manifest": ".agent/project.yaml",
    "context_index": ".agent/project-index.json",
    "file_cache": ".agent/cache/files.json",
    "legacy_intelligence_index": ".agent/intelligence.json",
    "command_allowlist": ".agent/commands.yaml",
    "capabilities": ".agent/capabilities.yaml",
    "auto_detect": true,
    "detected_signals": [
      "package.json", "pyproject.toml", "requirements.txt", "build.gradle",
      "settings.gradle", "AndroidManifest.xml", "Dockerfile", "*.tf",
      "*.ipynb", "*.fig", "docs/", "AGENTS.md", "README.md"
    ],
    "reversible": true,
    "note": "init --dry-run reports the plan without writing. Nothing irreversible happens without an explicit command."
  },

  "safety": {
    "bundled_dashboard": false,
    "project_commands": "allowlist only, from .agent/commands.yaml",
    "destructive_git_recovery": "never automatic",
    "secrets": "never stored in plaintext; credentials are never printed",
    "approval_gates": ["destructive_actions", "deployment", "publishing", "external_side_effects"],
    "plugin_trust_states": ["built_in", "trusted", "untrusted"],
    "untrusted_plugin_execution": false
  },

  "testing": {
    "command": "pytest",
    "real_ai_quota_consumed": false,
    "offline_provider": "mock",
    "cross_provider_demo": "agentctl demo --delay 0",
    "domain_matrix": "python scripts/domain_matrix.py",
    "context_cache_benchmark": "python scripts/context_cache_benchmark.py --dry-run",
    "real_context_cache_pair": "python scripts/context_cache_benchmark.py --execute --provider codex",
    "real_longitudinal_benchmark": "experimental; not the default benchmark"
  }
}
